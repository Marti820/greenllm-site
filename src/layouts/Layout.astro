---
import "../styles/global.css";

interface Props {
  title?: string;
}

const {
  title = "GreenLLM — Route every AI request to the right model",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta
      name="description"
      content="GreenLLM is the routing layer for enterprise AI. Route every request to the right model based on performance, cost, and estimated carbon impact — without changing existing workflows."
    />
    <meta
      name="keywords"
      content="LLM routing, AI routing, enterprise AI, model routing, LLM orchestration, AI infrastructure, cost optimization, carbon-aware AI, GreenLLM"
    />
    <meta name="theme-color" content="#c6f84e" />

    <meta
      property="og:title"
      content="GreenLLM — Route every AI request to the right model"
    />
    <meta
      property="og:description"
      content="GreenLLM helps teams adopt AI faster by routing each request to the best model based on performance, cost, and estimated carbon impact."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://greenllm-site.vercel.app/" />
    <meta property="og:image" content="/og-image.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="GreenLLM — Route every AI request to the right model"
    />
    <meta
      name="twitter:description"
      content="The routing layer for enterprise AI."
    />
    <meta name="twitter:image" content="/og-image.png" />

    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <div id="site-loader" class="site-loader" aria-hidden="true">
      <div class="loader-inner">
        <div class="loader-logo">
          <img src="/favicon.svg" alt="Logo" />
        </div>
        <div class="loader-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>
  
    <slot />
  
    <script>
      window.addEventListener("load", () => {
        const loader = document.getElementById("site-loader");
        if (loader) {
          loader.classList.add("is-hidden");
          setTimeout(() => loader.remove(), 500);
        }
      });
    </script>
  </body>
  </body>
</html>